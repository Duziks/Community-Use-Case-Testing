+def _wrapper_check_lowering_disable_cudagraph(fn):
+    @wraps(fn)
+    def decorated(device_node_mapping):
+        if any(device.type == "npu" for device in device_node_mapping):
+            from torch._inductor.cudagraph_utils import format_default_skip_message
+            # CUDA allocator/pool checks do not apply to NPU graphs.
+            return format_default_skip_message("NPU tensors are not supported by CUDA graphs")
+        return fn(device_node_mapping)
+
+    return decorated
+
+
+# Preserve the cached get_gpu_type interface used by Inductor registration.
+@functools.cache
 def _get_npu_type():
     return "npu"

